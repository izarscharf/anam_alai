# Generated by build.py — GitHub Actions rebuilds it on every push
manifest.json

# Python
.venv/
__pycache__/

# OS / editor clutter (often created when copying photos in)
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Local assistant instructions
CLAUDE.md

# Saved web pages (full copies of third-party articles)
news/*.html
news/*_files/

# Original TIFF scans (too large for GitHub; convert to PNG/JPG for the site)
*.tif
*.tiff

# Private documents (e.g. full CV with address and phone) and LibreOffice lock files
*.docx
.~lock.*
